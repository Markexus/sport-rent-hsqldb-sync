CREATE MEMORY TABLE PUBLIC.ABSTRACTPOSITION(ID BIGINT NOT NULL PRIMARY KEY,NAME VARCHAR(255),FLAGS INTEGER,DESCRIPTION VARCHAR(255),TI INTEGER)
CREATE MEMORY TABLE PUBLIC.RESERVATIONPOSITION(ID BIGINT NOT NULL PRIMARY KEY,BEGINDATE TIMESTAMP,ENDDATE TIMESTAMP,RESERVATIONDOCUMENT_ID BIGINT,RENTOBJECT_ID BIGINT,CUSTOMER_ID BIGINT,USEBONUSRATER BIT(1),BONUSTIME BIGINT DEFAULT 0,DIN DOUBLE,STORETAXHIB DOUBLE DEFAULT 0.22,PERCENTDISCOUNTHIB DOUBLE,VALUEDISCOUNTHIB DOUBLE,PRICE DOUBLE,PAYMENT DOUBLE,STATUS INTEGER DEFAULT 0,RATER_ID BIGINT,LISTINDEX INTEGER)
